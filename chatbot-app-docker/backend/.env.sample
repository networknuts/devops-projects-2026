# ====================================
# OpenAI Configuration
# ====================================

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4.1-mini

# ====================================
# CORS Configuration
# ====================================

CORS_ORIGINS=*

# ====================================
# PostgreSQL Configuration
# ====================================

DB_HOST=postgres
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppassword

# ====================================
# Application Configuration
# ====================================

APP_NAME=AI Question Answering API
APP_ENV=production
LOG_LEVEL=INFO
